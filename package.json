{
  "name": "somarkit",
  "version": "1.0.0",
  "private": true,
  "description": "SoMarkIt — curated AI tools directory built on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute somarkit --local --file=./db/schema.sql",
    "db:migrate": "wrangler d1 execute somarkit --remote --file=./db/schema.sql",
    "db:seed:local": "wrangler d1 execute somarkit --local --file=./db/seed.sql",
    "db:seed": "wrangler d1 execute somarkit --remote --file=./db/seed.sql",
    "build:css": "node scripts/build-css.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "seo:audit": "node scripts/seo-audit.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.71.0"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0"
  }
}
